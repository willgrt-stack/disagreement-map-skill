{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Disagreement Map project v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "input": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "context": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "sourceBoundary": {
          "type": "string"
        },
        "providerId": {
          "type": "string"
        }
      },
      "required": [
        "question",
        "views",
        "context",
        "goal",
        "sourceBoundary",
        "providerId"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "normalizedViews": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "viewId": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "conclusion": {
                "type": "string"
              },
              "basis": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mechanism": {
                "type": "string"
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "viewId",
              "label",
              "conclusion",
              "basis",
              "mechanism",
              "assumptions",
              "conditions"
            ],
            "additionalProperties": false
          }
        },
        "commonGround": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "surfaceDivergences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topic": {
                "type": "string"
              },
              "positions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "viewId": {
                      "type": "string"
                    },
                    "position": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "viewId",
                    "position"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "topic",
              "positions"
            ],
            "additionalProperties": false
          }
        },
        "rootDivergences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "question": {
                "type": "string"
              },
              "explanation": {
                "type": "string"
              },
              "explains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "title",
              "question",
              "explanation",
              "explains"
            ],
            "additionalProperties": false
          }
        },
        "inferenceBridges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "fact",
                  "probability",
                  "analogy",
                  "value",
                  "interpretation",
                  "causal",
                  "unknown"
                ]
              },
              "strength": {
                "type": "string",
                "enum": [
                  "strong",
                  "medium",
                  "weak",
                  "unknown"
                ]
              },
              "weakness": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to",
              "type",
              "strength",
              "weakness"
            ],
            "additionalProperties": false
          }
        },
        "causalChains": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "title",
              "nodes"
            ],
            "additionalProperties": false
          }
        },
        "missingInformation": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": "string"
              },
              "importance": {
                "type": "string"
              },
              "howToVerify": {
                "type": "string"
              }
            },
            "required": [
              "item",
              "importance",
              "howToVerify"
            ],
            "additionalProperties": false
          }
        },
        "evidenceStatus": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "supports",
                  "challenges",
                  "unknown"
                ]
              },
              "strength": {
                "type": "string",
                "enum": [
                  "strong",
                  "medium",
                  "weak",
                  "unknown"
                ]
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "claim",
              "status",
              "strength",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "provisionalJudgment": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            },
            "leansToward": {
              "type": "string"
            },
            "limits": {
              "type": "string"
            }
          },
          "required": [
            "summary",
            "leansToward",
            "limits"
          ],
          "additionalProperties": false
        },
        "falsifiablePredictions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "route": {
                "type": "string"
              },
              "predictions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "route",
              "predictions"
            ],
            "additionalProperties": false
          }
        },
        "meta": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "schemaVersion": {
              "const": 1
            },
            "incompleteSections": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [],
          "additionalProperties": true
        }
      },
      "required": [
        "normalizedViews",
        "commonGround",
        "surfaceDivergences",
        "rootDivergences",
        "inferenceBridges",
        "causalChains",
        "missingInformation",
        "evidenceStatus",
        "provisionalJudgment",
        "falsifiablePredictions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "createdAt",
    "updatedAt",
    "input",
    "result"
  ],
  "additionalProperties": false
}
